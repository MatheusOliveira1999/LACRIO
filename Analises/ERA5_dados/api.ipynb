   "source": [
    "import cdsapi\n",
    "import os\n",
    "\n",
    "client = cdsapi.Client()\n",
    "dataset = \"reanalysis-era5-single-levels\"\n",
    "\n",
    "# Diretório de saída\n",
    "output_dir = \"ERA5\"\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# Anos, meses, dias, horas\n",
    "years = [str(y) for y in range(1940, 2020)]\n",
    "months = [f\"{m:02d}\" for m in range(1, 13)]\n",
    "days = [f\"{d:02d}\" for d in range(1, 32)]\n",
    "times = [\"00:00\", \"06:00\", \"12:00\", \"18:00\"]\n",
    "area = [-8, -74, -9, -73]  # N, W, S, E\n",
    "\n",
    "for year in years:\n",
    "    # Solicitação para variáveis instantâneas\n",
    "    request_ins = {\n",
    "        \"product_type\": \"reanalysis\",\n",
    "        \"format\": \"netcdf\",\n",
    "        \"variable\": [\n",
    "            \"10m_u_component_of_wind\",\n",
    "            \"10m_v_component_of_wind\",\n",
    "            \"2m_dewpoint_temperature\",\n",
    "            \"2m_temperature\",\n",
    "            \"surface_pressure\",\n",
    "            \"geopotential\"\n",
    "        ],\n",
    "        \"year\": year,\n",
    "        \"month\": months,\n",
    "        \"day\": days,\n",
    "        \"time\": times,\n",
    "        \"area\": area\n",
    "    }\n",
    "\n",
    "    target_ins = os.path.join(output_dir, f\"ERA5_{year}_ins.nc\")\n",
    "    print(f\"Baixando {target_ins}...\")\n",
    "    client.retrieve(dataset, request_ins, target_ins)\n",
    "\n",
    "    # Solicitação para variáveis acumuladas\n",
    "    request_accum = {\n",
    "        \"product_type\": \"reanalysis\",\n",
    "        \"format\": \"netcdf\",\n",
    "        \"variable\": [\n",
    "            \"total_precipitation\",\n",
    "            \"surface_solar_radiation_downwards\",\n",
    "            \"surface_thermal_radiation_downwards\",\n",
    "            \"snowfall\"\n",
    "        ],\n",
    "        \"year\": year,\n",
    "        \"month\": months,\n",
    "        \"day\": days,\n",
    "        \"time\": times,\n",
    "        \"area\": area\n",
    "    }\n",
    "\n",
    "    target_accum = os.path.join(output_dir, f\"ERA5_{year}_accum.nc\")\n",
    "    print(f\"Baixando {target_accum}...\")\n",
    "    client.retrieve(dataset, request_accum, target_accum)\n",
    "    print(f\"Download completo para {year}.\")\n",
    "    print(\"Todos os downloads concluídos.\")"
   ]
  }
