   "source": [
    "import cdsapi\n",
    "import os\n",
    "\n",
    "client = cdsapi.Client()\n",
    "dataset = \"reanalysis-era5-single-levels\"\n",
    "\n",
    "# Define output directory\n",
    "output_dir = \"/home/matheus/Documentos/GitHub/LACRIO/Analises/ERA5_dados/dados_era5_03\"\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# Define years, all months, all days\n",
    "years = [str(y) for y in range(1968, 2021)]  # Ajuste conforme desejado\n",
    "months = [f\"{m:02d}\" for m in range(1, 13)]  # \"01\" a \"12\"\n",
    "days = [f\"{d:02d}\" for d in range(1, 32)]    # \"01\" a \"31\"\n",
    "times = [\"00:00\", \"06:00\", \"12:00\", \"18:00\"]\n",
    "\n",
    "area = [-8.5, -77.9, -9.9, -77]  # North, West, South, East\n",
    "\n",
    "# Loop through each year\n",
    "for year in years:\n",
    "    request_common = {\n",
    "        \"product_type\": \"reanalysis\",\n",
    "        \"data_format\": \"netcdf\",\n",
    "        \"download_format\": \"unarchived\",\n",
    "        \"year\": year,\n",
    "        \"month\": months,\n",
    "        \"day\": days,\n",
    "        \"time\": times,\n",
    "        \"area\": area\n",
    "    }\n",
    "\n",
    "    # Instantaneous variables\n",
    "    request_ins = request_common.copy()\n",
    "    request_ins[\"variable\"] = [\n",
    "        \"10m_u_component_of_wind\",\n",
    "        \"10m_v_component_of_wind\",\n",
    "        \"2m_dewpoint_temperature\",\n",
    "        \"2m_temperature\",\n",
    "        \"surface_pressure\",\n",
    "        \"geopotential\"\n",
    "    ]\n",
    "    \n",
    "    target_ins = os.path.join(output_dir, f\"ERA5_{year}_ins.nc\")\n",
    "    print(f\"Downloading {target_ins}...\")\n",
    "    client.retrieve(dataset, request_ins, target_ins)\n",
    "\n",
    "    # Accumulated variables\n",
    "    request_accum = request_common.copy()\n",
    "    request_accum[\"variable\"] = [\n",
    "        \"total_precipitation\",\n",
    "        \"surface_solar_radiation_downwards\",\n",
    "        \"surface_thermal_radiation_downwards\",\n",
    "        \"snowfall\"\n",
    "    ]\n",
    "\n",
    "    target_accum = os.path.join(output_dir, f\"ERA5_{year}_accum.nc\")\n",
    "    print(f\"Downloading {target_accum}...\") \n",
    "    client.retrieve(dataset, request_accum, target_accum)\n"
   ]
  },
