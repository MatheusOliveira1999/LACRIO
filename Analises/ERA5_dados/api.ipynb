   "source": [
    "import cdsapi\n",
    "import os\n",
    "\n",
    "# Diretório de saída\n",
    "output_dir = \"dados_era5\"\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "\n",
    "# Dataset e parâmetros\n",
    "dataset = \"reanalysis-era5-pressure-levels\"\n",
    "anos = [str(ano) for ano in range(1940, 2026)]\n",
    "meses = [f\"{m:02d}\" for m in range(1, 13)]\n",
    "\n",
    "# Template base da requisição\n",
    "def get_request_template(dias):\n",
    "    return {\n",
    "        \"product_type\": \"reanalysis\",\n",
    "        \"variable\": [\n",
    "            \"geopotential\",\n",
    "            \"specific_humidity\",\n",
    "            \"specific_rain_water_content\",\n",
    "            \"temperature\",\n",
    "            \"u_component_of_wind\",\n",
    "            \"v_component_of_wind\"\n",
    "        ],\n",
    "        \"day\": dias,\n",
    "        \"time\": [f\"{h:02d}:00\" for h in range(24)],\n",
    "        \"pressure_level\": [\"300\", \"400\", \"500\"],\n",
    "        \"format\": \"netcdf\",\n",
    "        \"area\": [-8.5, -77.9, -9.9, -77],\n",
    "    }\n",
    "\n",
    "# Inicializa cliente\n",
    "client = cdsapi.Client()\n",
    "\n",
    "# Loop principal\n",
    "for ano in anos:\n",
    "    for mes in meses:\n",
    "        output_file = os.path.join(output_dir, f\"era5_{ano}_{mes}.nc\")\n",
    "\n",
    "        if os.path.exists(output_file):\n",
    "            print(f\"Arquivo já existe: {output_file}, pulando download.\")\n",
    "            continue\n",
    "\n",
    "        print(f\"Tentando baixar dados para {ano}-{mes}...\")\n",
    "\n",
    "        # Requisição completa (dia 01 ao 31)\n",
    "        try:\n",
    "            request = get_request_template([f\"{d:02d}\" for d in range(1, 32)])\n",
    "            request[\"year\"] = ano\n",
    "            request[\"month\"] = mes\n",
    "\n",
    "            client.retrieve(dataset, request, output_file)\n",
    "            print(f\"✅ Sucesso: {output_file}\")\n",
    "            continue\n",
    "\n",
    "        except Exception as e:\n",
    "            print(f\"⚠️ Falha no mês completo: {e}\")\n",
    "            print(\"➡️ Tentando dividir o mês em duas partes...\")\n",
    "\n",
    "        # Divisão: dias 1–15\n",
    "        try:\n",
    "            output_file_half1 = os.path.join(output_dir, f\"era5_{ano}_{mes}_part1.nc\")\n",
    "            request_half1 = get_request_template([f\"{d:02d}\" for d in range(1, 16)])\n",
    "            request_half1[\"year\"] = ano\n",
    "            request_half1[\"month\"] = mes\n",
    "\n",
    "            client.retrieve(dataset, request_half1, output_file_half1)\n",
    "            print(f\"✅ Parte 1 salva: {output_file_half1}\")\n",
    "        except Exception as e1:\n",
    "            print(f\"❌ Falha na Parte 1: {e1}\")\n",
    "\n",
    "        # Divisão: dias 16–31\n",
    "        try:\n",
    "            output_file_half2 = os.path.join(output_dir, f\"era5_{ano}_{mes}_part2.nc\")\n",
    "            request_half2 = get_request_template([f\"{d:02d}\" for d in range(16, 32)])\n",
    "            request_half2[\"year\"] = ano\n",
    "            request_half2[\"month\"] = mes\n",
    "\n",
    "            client.retrieve(dataset, request_half2, output_file_half2)\n",
    "            print(f\"✅ Parte 2 salva: {output_file_half2}\")\n",
    "        except Exception as e2:\n",
    "            print(f\"❌ Falha na Parte 2: {e2}\")\n"
   ]
  },
